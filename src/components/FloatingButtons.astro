---
import Icon from './Icon.astro';

const KAKAO_URL = "https://pf.kakao.com/_xoxilmn";
const PHONE_URL = "tel:01050741018";
---

<div 
  id="floating-buttons"
  class="fixed bottom-5 right-5 md:bottom-8 md:right-8 z-[1200] flex flex-col gap-3 transition-all duration-500 opacity-0 translate-y-10 pointer-events-none"
>
  <a 
    href={KAKAO_URL} 
    target="_blank" 
    rel="noopener noreferrer"
    class="w-12 h-12 md:w-14 md:h-14 bg-[#FEE500] rounded-full flex items-center justify-center shadow-[0_8px_25px_rgba(0,0,0,0.12)] hover:scale-110 active:scale-95 transition-all"
    aria-label="카카오톡 상담"
  >
    <Icon name="kakao" size={24} class="text-[#3c1e1e] md:hidden" />
    <Icon name="kakao" size={28} class="text-[#3c1e1e] hidden md:block" />
  </a>

  <a 
    href={PHONE_URL} 
    class="w-12 h-12 md:w-14 md:h-14 bg-white border border-[#ececec] rounded-full flex items-center justify-center shadow-[0_8px_25px_rgba(0,0,0,0.12)] hover:scale-110 active:scale-95 transition-all"
    aria-label="전화 상담"
  >
    <Icon name="phone" size={22} class="text-[#1a1a1a] md:hidden" />
    <Icon name="phone" size={26} class="text-[#1a1a1a] hidden md:block" />
  </a>
</div>

<script>
  const floating = document.getElementById('floating-buttons');
  
  if (floating) {
    const handleScroll = () => {
      if (window.scrollY > 300) {
        floating.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
        floating.classList.add('opacity-100', 'translate-y-0');
      } else {
        floating.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
        floating.classList.remove('opacity-100', 'translate-y-0');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    
    handleScroll();
  }
</script>
