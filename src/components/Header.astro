---
import Icon from './Icon.astro';

const navItems = [
  { label: '작업 방식', href: '#about' },
  { label: '진행 과정', href: '#process' },
  { label: '갤러리', href: '#gallery' },
  { label: '후기', href: '#reviews' },
  { label: '문의/지도', href: '#contact' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  data-on-dark="true"
>
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 h-[72px] flex items-center justify-between">
    <a
      href="#top"
      class="flex items-baseline gap-2 group"
      aria-label="PROWRAP 홈"
    >
      <span class="font-black text-[15px] tracking-[0.18em] header-logo-main">
        PROWRAP
      </span>
      <span class="hidden sm:inline-block text-[10px] tracking-[0.22em] header-logo-sub opacity-70">
        REAL FILM REAL FINISH
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-8" aria-label="주요 메뉴">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="header-link text-[14px] font-medium tracking-[-0.01em] relative"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="#estimate"
        class="hidden lg:inline-flex items-center gap-2 px-5 py-2.5 text-[13px] font-semibold tracking-[-0.01em] header-cta border rounded-full"
      >
        견적 문의
        <Icon name="arrow-right" size={14} />
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden header-menu-btn p-2 -mr-2"
        aria-label="메뉴 열기"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] bg-pw-bg opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
>
  <div class="h-[72px] flex items-center justify-between px-6">
    <span class="font-black text-[15px] tracking-[0.18em] text-pw-accent">PROWRAP</span>
    <button
      id="menu-close"
      type="button"
      class="p-2 -mr-2 text-pw-accent"
      aria-label="메뉴 닫기"
    >
      <Icon name="close" size={24} />
    </button>
  </div>

  <nav class="px-6 pt-6" aria-label="모바일 메뉴">
    <ul class="space-y-1">
      {navItems.map((item, i) => (
        <li class="border-b border-pw-border">
          <a
            href={item.href}
            class="mobile-link flex items-center justify-between py-5"
            data-menu-link
          >
            <span class="flex items-baseline gap-3">
              <span class="text-[11px] text-pw-text-mute font-medium tracking-[0.1em]">
                0{i + 1}
              </span>
              <span class="text-[22px] font-bold text-pw-accent tracking-[-0.02em]">
                {item.label}
              </span>
            </span>
            <Icon name="arrow-right" size={18} class="text-pw-text-soft" />
          </a>
        </li>
      ))}
    </ul>

    <a
      href="#estimate"
      data-menu-link
      class="mt-8 inline-flex items-center justify-center gap-2 w-full py-4 bg-pw-accent text-white text-[15px] font-semibold rounded-full"
    >
      견적 문의하기
      <Icon name="arrow-right" size={16} />
    </a>

    <div class="mt-6 flex items-center justify-center gap-4 text-[13px] text-pw-text-soft">
      <a href="tel:01050741018" class="inline-flex items-center gap-1.5">
        <Icon name="phone" size={14} />
        <span>010-5074-1018</span>
      </a>
    </div>
  </nav>
</div>

<style>
  /* 헤더 라이트 모드 (스크롤 후 또는 라이트 섹션 위) */
  #site-header[data-on-dark="false"] .header-logo-main { color: #0a0a0a; }
  #site-header[data-on-dark="false"] .header-logo-sub { color: #6b6b6b; }
  #site-header[data-on-dark="false"] .header-link { color: #4a4a4a; }
  #site-header[data-on-dark="false"] .header-link:hover { color: #0a0a0a; }
  #site-header[data-on-dark="false"] .header-cta {
    color: #0a0a0a;
    border-color: #0a0a0a;
    background: transparent;
  }
  #site-header[data-on-dark="false"] .header-cta:hover {
    background: #0a0a0a;
    color: #ffffff;
  }
  #site-header[data-on-dark="false"] .header-menu-btn { color: #0a0a0a; }

  /* 헤더 다크 모드 (Hero 배경 위) — 라인/띠 없음, 인라인 스타일이 배경을 결정 */
  #site-header[data-on-dark="true"] {
    background: transparent;
  }
  #site-header[data-on-dark="true"] .header-logo-main { color: #ffffff; }
  #site-header[data-on-dark="true"] .header-logo-sub { color: rgba(255,255,255,0.7); }
  #site-header[data-on-dark="true"] .header-link { color: rgba(255,255,255,0.85); }
  #site-header[data-on-dark="true"] .header-link:hover { color: #ffffff; }
  #site-header[data-on-dark="true"] .header-cta {
    color: #ffffff;
    border-color: rgba(255,255,255,0.45);
    background: transparent;
  }
  #site-header[data-on-dark="true"] .header-cta:hover {
    background: #ffffff;
    color: #0a0a0a;
    border-color: #ffffff;
  }
  #site-header[data-on-dark="true"] .header-menu-btn { color: #ffffff; }

  .header-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.25s ease;
  }
  .header-link:hover::after {
    width: 100%;
  }

  #mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-link span {
    transition: transform 0.25s ease;
  }
  .mobile-link:hover > span:first-child {
    transform: translateX(4px);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const heroSection = document.getElementById('hero');

  function updateHeader() {
    if (!header) return;
    const scrolled = window.scrollY > 20;

    if (heroSection) {
      const heroBottom = heroSection.offsetTop + heroSection.offsetHeight - 80;
      const inHero = window.scrollY < heroBottom;

      if (inHero && !scrolled) {
        header.dataset.onDark = 'true';
        header.classList.remove('header-scrolled');
        header.style.background = 'transparent';
        header.style.backdropFilter = 'none';
        header.style.borderBottom = '1px solid transparent';
        header.style.boxShadow = 'none';
      } else if (inHero && scrolled) {
        header.dataset.onDark = 'true';
        header.style.background = 'rgba(5,5,5,0.7)';
        header.style.backdropFilter = 'saturate(1.4) blur(12px)';
        header.style.borderBottom = '1px solid transparent';
        header.style.boxShadow = 'none';
      } else {
        header.dataset.onDark = 'false';
        header.style.background = 'rgba(255,255,255,0.94)';
        header.style.backdropFilter = 'saturate(1.4) blur(12px)';
        header.style.borderBottom = '1px solid transparent';
        header.style.boxShadow = '0 8px 22px rgba(0,0,0,0.05)';
      }
    } else {
      header.dataset.onDark = 'false';
      if (scrolled) {
        header.classList.add('header-scrolled');
      } else {
        header.classList.remove('header-scrolled');
      }
    }
  }

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
  window.addEventListener('resize', updateHeader, { passive: true });

  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');

  function openMenu() {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.classList.add('is-open');
    mobileMenu.setAttribute('aria-hidden', 'false');
    menuToggle.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-open');
  }

  function closeMenu() {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.classList.remove('is-open');
    mobileMenu.setAttribute('aria-hidden', 'true');
    menuToggle.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
  }

  menuToggle?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);

  // 메뉴 내 링크 클릭 시 자동 닫기
  document.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // ESC 키로 닫기
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu?.classList.contains('is-open')) {
      closeMenu();
    }
  });
</script>
