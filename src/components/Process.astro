---

type Step = {
  num: string;
  title: string;
  body: string;
};

const steps: Step[] = [
  {
    num: '01',
    title: '사진 전송 & 상담',
    body: '시공을 원하시는 공간의 사진과 주소, 희망 일정을 카카오톡으로 보내주세요. 방문 없이도 자재 종류와 작업 범위를 먼저 파악하여 안내해 드립니다.',
  },
  {
    num: '02',
    title: '필름 · 견적 안내',
    body: '공간에 어울리는 필름을 함께 고르고, 예상 견적과 작업 소요 시간, 가능한 일정을 안내드립니다.',
  },
  {
    num: '03',
    title: '방문 시공 & 마감 체크',
    body: '예약된 날짜에 방문하여 시공을 진행하고, 마감 상태와 사용감까지 함께 체크해 드립니다.',
  },
];
---

<section
  id="process"
  class="bg-[#f8f7f4] py-24 md:py-28 lg:py-36"
  data-animate="fade-up"
>
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <header class="max-w-2xl">
      <div class="flex items-center gap-3 text-[13px] tracking-[0.25em] text-[#6b6b6b] uppercase font-bold">
        <span class="inline-block w-2 h-2 rounded-full bg-[#ff7a1a]"></span>
        <span>How It Works</span>
      </div>

      <h2
        class="mt-8 font-black leading-tight text-[#1a1a1a] tracking-tight"
        style="font-size: clamp(1.75rem, 3.5vw, 2.2rem);"
      >
        시공 진행 과정
      </h2>
      <p class="mt-8 text-[17px] md:text-[18px] leading-8 text-[#6b6b6b] max-w-xl font-light">
        복잡한 절차 없이, 사진 한 장으로부터 시공까지 간단하게 진행됩니다.
      </p>
    </header>

    <div class="mt-20 h-px bg-[#ececec]"></div>

    <ol class="mt-0 grid grid-cols-1 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="border-t-0 md:border-t-0 pt-0">
          <div
            class:list={[
              'py-16 md:py-20',
              i !== 0 && 'md:pl-12 md:border-l md:border-[#ececec]',
              i === 0 && 'md:pr-12',
              i === 1 && 'md:pr-12',
              'border-t border-[#ececec] first:border-t-0',
            ]}
          >
            <div class="flex items-center gap-4 mb-8">
              <span class="inline-block w-4 h-px bg-[#ff7a1a]"></span>
              <span class="font-black text-[3.5rem] leading-none tracking-tighter text-[#1a1a1a]/10 select-none italic">
                {s.num}
              </span>
            </div>

            <h3 class="font-black text-[1.25rem] leading-snug text-[#1a1a1a] mb-6 tracking-tight">
              {s.title}
            </h3>

            <p class="text-[16px] leading-8 text-[#555555] font-normal">
              {s.body}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
