---

import Icon from './Icon.astro';

const KAKAO_URL = 'https://pf.kakao.com/_xoxilmn';
const TEL = '01050741018';
const TEL_DISPLAY = '010-5074-1018';

const items = [
  '시공 주소 (동 · 평수)',
  '시공을 원하시는 공간 (예: 주방 상판, 싱크대, 방문 3짝 등)',
  '현재 상태가 보이는 사진 5장 이상',
  '희망 일정 (평일/주말, 오전/오후)',
];
---

<section
  id="estimate"
  class="bg-white py-24 md:py-28 lg:py-36 border-t border-[#ececec]"
  data-animate="fade-up"
>
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="max-w-[740px] mx-auto">
            <div class="flex items-center gap-3 text-[13px] tracking-[0.25em] text-[#6b6b6b] uppercase font-bold">
        <span class="inline-block w-2 h-2 rounded-full bg-[#ff7a1a]"></span>
        <span>Get a Quote</span>
      </div>

      <h2
        class="mt-8 font-black leading-snug text-[#1a1a1a] tracking-tight"
        style="font-size: clamp(1.75rem, 3.5vw, 2.2rem);"
      >
        견적 신청 방법
      </h2>
      <p class="mt-8 text-[17px] md:text-[18px] leading-8 text-[#6b6b6b] font-light">
        카카오톡 또는 문자로 아래 정보를 보내주시면, 확인 후 예상 견적과 가능 일정을 안내드립니다.
      </p>

      <ol class="mt-12 space-y-6">
        {items.map((item, i) => (
          <li class="flex items-start gap-5">
            <span
              class="flex-shrink-0 w-8 h-8 rounded-full bg-[#1a1a1a] text-white
                     flex items-center justify-center text-[13px] font-black leading-none"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <span class="text-[17px] leading-8 text-[#1a1a1a] pt-0.5 font-medium">
              {item}
            </span>
          </li>
        ))}
      </ol>

      <div class="mt-12 h-px bg-[#ececec]"></div>

      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a
          href={KAKAO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3
                 bg-[#FEE500] text-black font-bold text-[15px]
                 px-8 py-4 rounded-sm
                 hover:bg-[#fdd800] transition-colors duration-200"
        >
          <Icon name="kakao" size={20} />
          카카오톡 채널 문의
        </a>

        <a
          href={`tel:${TEL}`}
          class="inline-flex items-center justify-center gap-3
                 border border-[#1a1a1a] text-[#1a1a1a] font-bold text-[15px]
                 px-8 py-4 rounded-sm
                 hover:bg-[#1a1a1a] hover:text-white transition-colors duration-200"
        >
          <Icon name="phone" size={18} />
          {TEL_DISPLAY}
        </a>
      </div>

      <p class="mt-6 text-[13px] text-[#6b6b6b]">
        고양·파주·인천·서울 지역 시공 가능 - 원거리는 사전 문의 후 조율합니다.
      </p>
    </div>
  </div>
</section>
