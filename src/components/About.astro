---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import imgSameDay from '../assets/images/about/sameday.png';
import imgDirectTeam from '../assets/images/about/direct-team.png';
import imgQualityFilm from '../assets/images/about/quality-film.png';

type Feature = {
  index: string;
  kicker: string;
  title: string;
  body: string;
  caption: string;
  image?: ImageMetadata;
};

const features: Feature[] = [
  {
    index: '01',
    kicker: 'Same-Day Work',
    title: '상담 후 당일 시공도 가능합니다',
    body: '입주 날짜가 촉박하거나, 영업일을 오래 비우기 어렵다면 <strong class="text-white">오전 상담 → 오후 시공 → 저녁 마감 체크</strong>까지 하루 안에 끝낼 수 있도록 일정을 조율합니다. 공간을 오래 비우지 않고도, 다음 날 바로 생활하거나 영업을 이어가실 수 있도록 작업 동선을 설계합니다.',
    caption: 'Same-day work',
    image: imgSameDay,
  },
  {
    index: '02',
    kicker: 'Direct Team',
    title: '외주업체 없이 직거래 시공팀입니다',
    body: 'PROWRAP은 외주 인력에 맡기지 않고 <strong class="text-white">상담–현장 방문–시공–마감 확인</strong>까지 한 팀이 끝까지 책임집니다. 불필요한 중간 마진을 줄여 합리적인 견적을 만들고, 공정마다 전달이 꼬이지 않아 작업 퀄리티가 일정하게 유지됩니다.',
    caption: 'Direct specialist team',
    image: imgDirectTeam,
  },
  {
    index: '03',
    kicker: 'Transparent Price',
    title: '더 이상 감으로만 견적 받지 마세요',
    body: 'PROWRAP은 <strong class="text-white">항목별 단가 기준</strong>으로 견적을 안내드립니다. "그냥 이 정도면 ○○만원이요"가 아니라, 어떤 부분에 얼마가 들어가는지 이해하기 쉽게 설명해 드립니다. 정품 필름 사용, 하자 보증 기간, 추가 옵션 여부까지 견적에 포함된 내용을 투명하게 공유합니다.',
    caption: 'Itemised pricing',
    image: imgQualityFilm,
  },
];
---

<section id="about" class="relative bg-[#050505] text-white overflow-hidden pt-24 md:pt-32 lg:pt-48 pb-0">
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 80% 60% at 20% 40%, rgba(255,122,26,0.04) 0%, transparent 60%), radial-gradient(ellipse 60% 50% at 80% 70%, rgba(255,255,255,0.02) 0%, transparent 50%);"></div>
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 mb-20 lg:mb-32">
    <header class="max-w-4xl">
      <div class="flex items-center gap-3 text-[12px] tracking-[0.3em] text-white/40 uppercase font-bold">
        <span class="inline-block w-6 h-px bg-[#ff7a1a]"></span>
        <span>About PROWRAP</span>
      </div>

      <h2
        class="mt-8 font-black leading-[1.2] text-white tracking-tight"
        style="font-size: clamp(1.8rem, 4vw, 2.4rem);"
      >
        오전에 상담하고, 저녁엔 새로운 공간에서 쉴 수 있도록.<br class="hidden md:block" />
        빠르지만 허투루 넘기지 않는 시공을 약속드립니다.
      </h2>

      <p class="mt-8 text-[16px] md:text-[18px] leading-8 text-white/60 max-w-2xl font-light">
        고양·파주 지역에서 인테리어필름 시공을 직거래로 진행합니다.
        견적부터 마감까지 같은 사람이 들어가도록 운영하는 이유와, 가격을
        구성하는 방식을 그대로 적어두었습니다.
      </p>
    </header>

    <div class="mt-16 lg:mt-24 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
  </div>

  <div class="space-y-0 lg:space-y-0">
    {
      features.map((f, i) => {
        const reverse = i % 2 === 1;
        return (
          <article
            class:list={[
              'grid grid-cols-1 lg:grid-cols-2 w-full min-h-[500px] lg:min-h-[650px]',
              reverse && 'lg:[&>*:first-child]:order-2',
            ]}
            data-animate="fade-up"
          >
            <div class:list={[
              'flex flex-col justify-center py-16 px-6 lg:px-0',
              !reverse ? 'lg:items-end' : 'lg:items-start'
            ]}>
              <div class:list={[
                'w-full max-w-[640px]',
                !reverse ? 'lg:pr-20' : 'lg:pl-20'
              ]}>
                <div class="flex items-baseline gap-4 mb-6">
                  <span class="font-black text-4xl tracking-tighter text-white/15 italic">
                    {f.index}
                  </span>
                  <span class="text-[11px] tracking-[0.3em] uppercase font-bold text-white/50">
                    {f.kicker}
                  </span>
                </div>

                <h3 class="font-bold text-[1.6rem] md:text-[2rem] leading-[1.2] text-white tracking-tight mb-8">
                  {f.title}
                </h3>

                <div class="text-[16px] md:text-[17px] leading-8 text-white/70 space-y-6 font-normal">
                   <p set:html={f.body.replace(/<strong/g, '<strong class="text-white font-bold border-b border-[#ff7a1a]/40 pb-0.5"')} />
                </div>
              </div>
            </div>

            <figure class="relative w-full h-full min-h-[400px] lg:min-h-0 overflow-hidden bg-[#0e0e0e]">
              {f.image ? (
                <Image
                  src={f.image}
                  alt={f.title}
                  width={1200}
                  class="w-full h-full object-cover grayscale-[0.3] hover:grayscale-0 transition-all duration-700"
                />
              ) : (
                <div
                  aria-hidden="true"
                  class="absolute inset-0"
                  style="background:
                    linear-gradient(135deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0) 60%),
                    repeating-linear-gradient(45deg, rgba(255,255,255,0.03) 0 1px, transparent 1px 20px);"
                ></div>
              )}
              
              <div class="absolute inset-0 bg-black/10"></div>
              
              <figcaption class="absolute left-8 bottom-8 flex items-center gap-3 text-[12px] tracking-[0.25em] uppercase text-white/80 font-bold">
                <span class="inline-block w-6 h-px bg-[#ff7a1a]"></span>
                <span>{f.caption}</span>
              </figcaption>
            </figure>
          </article>
        );
      })
    }
  </div>
</section>
