---

import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import GalleryFilter from './GalleryFilter.astro';
import Icon from './Icon.astro';
import type { SpaceKey } from '../data/spaceMapping';

// ── JSON 컬렉션 로드 (Pages CMS가 관리하는 파일들) ─────────────
type GalleryEntry = {
  image: string;       // "/src/assets/gallery/.../filename.jpg"
  sections: SpaceKey[];
  caption: string;
  order: number;
};

const entryModules = import.meta.glob<{ default: GalleryEntry }>(
  '/src/data/gallery/*.json',
  { eager: true }
);

const entries: GalleryEntry[] = Object.values(entryModules)
  .map((m) => m.default)
  .sort((a, b) => a.order - b.order || a.image.localeCompare(b.image));

// ── 이미지 파일 로드 (빌드타임 최적화용) ──────────────────────
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/**/*.{jpg,jpeg,png,webp,JPG,PNG}',
  { eager: true }
);

type GalleryItem = {
  src: ImageMetadata;
  lightboxSrc: string;
  sections: SpaceKey[];
  caption: string;
};

const items: GalleryItem[] = (
  await Promise.all(
    entries.map(async (entry) => {
      const mod = imageModules[entry.image];
      if (!mod) return null;
      const optimized = await getImage({ src: mod.default, format: 'webp', width: 1440 });
      return {
        src: mod.default,
        lightboxSrc: optimized.src,
        sections: entry.sections,
        caption: entry.caption,
      };
    })
  )
).filter((x): x is GalleryItem => x !== null);

const isEmpty = items.length === 0;
---

<section
  id="gallery"
  class="bg-white py-24 md:py-28 lg:py-36 border-t border-[#ececec]"
  data-animate="fade-up"
>
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <header class="max-w-2xl mb-12 lg:mb-16">
      <div class="flex items-center gap-3 text-xs tracking-[0.2em] text-[#6b6b6b] uppercase">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#ff7a1a]"></span>
        <span>Project Gallery</span>
      </div>

      <h2
        class="mt-6 font-bold leading-snug text-[#1a1a1a]"
        style="font-size: clamp(1.6rem, 2.4vw, 1.9rem);"
      >
        시공 갤러리
      </h2>

      <p class="mt-5 text-[15px] leading-7 text-[#6b6b6b]">
        PROWRAP의 다양한 현장 결과물을 확인해 보세요. 공간별로 분류해 두었으며, 클릭하면 큰 화면으로 자재를 확인할 수 있습니다.
      </p>
    </header>

    <div class="mb-10 -mx-1 overflow-x-auto">
      <GalleryFilter />
    </div>

    {isEmpty ? (
      <div class="border border-dashed border-[#ececec] py-20 text-center text-[#6b6b6b] text-sm">
        갤러리 이미지를 준비 중입니다.
      </div>
    ) : (
      <ul
        id="gallery-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4"
      >
        {items.map((it, i) => (
          <li
            class="gallery-item group relative overflow-hidden rounded-sm bg-[#f8f7f4]"
            data-categories={it.sections.join(' ')}
            data-caption={it.caption}
            data-index={i}
          >
            <button
              type="button"
              class="block w-full text-left"
              data-lightbox-open
              data-lightbox-src={it.lightboxSrc}
              data-index={i}
              aria-label={it.caption || '시공 사진 보기'}
            >
              <div class="aspect-[4/3] w-full overflow-hidden">
                <Image
                  src={it.src}
                  alt={it.caption || '인테리어필름 시공 사진'}
                  loading={i < 6 ? "eager" : "lazy"}
                  decoding="async"
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </div>

              {it.caption && (
                <div
                  class="pointer-events-none absolute inset-x-0 bottom-0 px-4 py-3
                         bg-gradient-to-t from-black/70 to-transparent
                         opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                >
                  <span class="text-white text-[13px] tracking-wide">
                    {it.caption}
                  </span>
                </div>
              )}
            </button>
          </li>
        ))}
      </ul>
    )}
    
    {!isEmpty && (
      <div class="mt-12 text-center" id="load-more-container">
        <button
          type="button"
          id="load-more-btn"
          class="inline-flex items-center justify-center px-8 py-3.5 border border-[#ececec] text-[14px] font-bold tracking-wide text-[#1a1a1a] bg-white hover:bg-[#f8f7f4] hover:border-[#d4d4d4] rounded-sm transition-all"
        >
          더보기 (Load More)
        </button>
      </div>
    )}
  </div>
</section>

{/* Lightbox는 반드시 [data-animate] (transform 적용) 밖에 위치해야 position:fixed 가 viewport 기준으로 동작합니다. */}
<div
  id="lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/92 px-4"
  role="dialog"
  aria-modal="true"
  aria-label="확대 보기"
>
  <button
    type="button"
    class="absolute top-5 right-5 text-white/80 hover:text-white p-2 z-10"
    data-lightbox-close
    aria-label="닫기"
  >
    <Icon name="close" size={24} />
  </button>

  <button
    type="button"
    class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white p-3 text-3xl leading-none z-10"
    data-lightbox-prev
    aria-label="이전"
  >
    ‹
  </button>

  <figure class="relative max-w-[92vw] max-h-[88vh] flex flex-col items-center gap-3">
    <div class="relative max-w-full max-h-[78vh] flex items-center justify-center">
      {/* 썸네일 즉시 표시 (블러 처리) */}
      <img
        id="lightbox-thumb"
        src=""
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-contain blur-sm scale-[1.02] opacity-0 transition-opacity duration-200"
      />
      {/* 고해상도 — 로드 완료 시 페이드인 */}
      <img
        id="lightbox-img"
        src=""
        alt=""
        decoding="async"
        fetchpriority="high"
        class="relative max-w-full max-h-[78vh] object-contain opacity-0 transition-opacity duration-300"
      />
      {/* 스피너 */}
      <div
        id="lightbox-spinner"
        class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-200"
        aria-hidden="true"
      >
        <span class="block w-8 h-8 rounded-full border-2 border-white/25 border-t-white/85 animate-spin"></span>
      </div>
    </div>
    <figcaption
      id="lightbox-caption"
      class="text-white/85 text-sm tracking-wide text-center min-h-[1.25em]"
    ></figcaption>
  </figure>

  <button
    type="button"
    class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white p-3 text-3xl leading-none z-10"
    data-lightbox-next
    aria-label="다음"
  >
    ›
  </button>
</div>

<script>
  type LBItem = { src: string; caption: string; thumbSrc: string };

  function initLightbox() {
    const root = document.getElementById('lightbox');
    const imgEl = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const thumbEl = document.getElementById('lightbox-thumb') as HTMLImageElement | null;
    const spinnerEl = document.getElementById('lightbox-spinner');
    const capEl = document.getElementById('lightbox-caption');
    if (!root || !imgEl || !capEl) return;

    const triggers = document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]');

    /* 썸네일 currentSrc 추출 — 즉시 placeholder 로 사용 */
    const list: LBItem[] = Array.from(triggers).map((btn) => {
      const src = btn.dataset.lightboxSrc || '';
      const item = btn.closest('.gallery-item') as HTMLElement | null;
      const caption = item?.dataset.caption ?? '';
      const thumbImg = item?.querySelector('img') as HTMLImageElement | null;
      const thumbSrc = thumbImg?.currentSrc || thumbImg?.src || '';
      return { src, caption, thumbSrc };
    });

    /* 프리로드 캐시 — 같은 이미지 중복 요청 방지 */
    const preloaded = new Set<string>();
    function preload(src: string) {
      if (!src || preloaded.has(src)) return;
      preloaded.add(src);
      const img = new Image();
      img.decoding = 'async';
      img.src = src;
    }

    /* 마우스오버/포커스 시 해당 이미지 프리로드 */
    triggers.forEach((btn) => {
      const src = btn.dataset.lightboxSrc || '';
      const trigger = () => preload(src);
      btn.addEventListener('mouseenter', trigger, { once: true });
      btn.addEventListener('focus', trigger, { once: true });
      btn.addEventListener('touchstart', trigger, { once: true, passive: true });
    });

    /* idle 시점에 첫 4장만 백그라운드 프리로드 — 첫 클릭 즉시 표시 */
    const idle = (cb: () => void) => {
      // @ts-ignore
      if ('requestIdleCallback' in window) (window as any).requestIdleCallback(cb, { timeout: 2500 });
      else setTimeout(cb, 1500);
    };
    idle(() => {
      list.slice(0, 4).forEach((it) => preload(it.src));
    });

    let current = 0;
    let pendingSrc = '';

    function getVisibleIndexes(): number[] {
      return Array.from(triggers)
        .map((btn, i) => ({ i, hidden: (btn.closest('.gallery-item') as HTMLElement).hidden }))
        .filter((x) => !x.hidden)
        .map((x) => x.i);
    }

    function preloadNeighbors() {
      const visible = getVisibleIndexes();
      if (!visible.length) return;
      const pos = visible.indexOf(current);
      if (pos < 0) return;
      const nextIdx = visible[(pos + 1) % visible.length];
      const prevIdx = visible[(pos - 1 + visible.length) % visible.length];
      preload(list[nextIdx]?.src);
      preload(list[prevIdx]?.src);
    }

    function open(index: number) {
      current = index;
      render();
      root!.classList.remove('hidden');
      root!.classList.add('flex');
      document.body.style.overflow = 'hidden';
      preloadNeighbors();
    }
    function close() {
      root!.classList.add('hidden');
      root!.classList.remove('flex');
      document.body.style.overflow = '';
    }
    function move(delta: number) {
      const visible = getVisibleIndexes();
      if (!visible.length) return;
      const pos = visible.indexOf(current);
      const next = visible[(pos + delta + visible.length) % visible.length];
      current = next;
      render();
      preloadNeighbors();
    }

    function render() {
      const it = list[current];
      if (!it || !imgEl || !capEl) return;

      pendingSrc = it.src;
      capEl.textContent = it.caption;
      imgEl.alt = it.caption;

      /* 1) 썸네일을 즉시 placeholder 로 표시 */
      if (thumbEl) {
        thumbEl.src = it.thumbSrc;
        thumbEl.alt = it.caption;
        thumbEl.classList.remove('opacity-0');
      }

      /* 2) 캐시된 이미지면 스피너 생략, 아니면 200ms 후에만 스피너 노출 */
      const isCached = preloaded.has(it.src);
      imgEl.classList.add('opacity-0');
      if (spinnerEl) spinnerEl.classList.add('opacity-0');

      let spinnerTimer: number | null = null;
      if (!isCached && spinnerEl) {
        spinnerTimer = window.setTimeout(() => {
          spinnerEl.classList.remove('opacity-0');
        }, 180);
      }

      /* 3) 고해상도 로드 후 페이드인 */
      const onLoad = () => {
        if (pendingSrc !== it.src) return; // 다른 이미지로 이동한 경우 무시
        if (spinnerTimer) clearTimeout(spinnerTimer);
        if (spinnerEl) spinnerEl.classList.add('opacity-0');
        imgEl.classList.remove('opacity-0');
        if (thumbEl) {
          /* 페이드인 후 썸네일은 살짝 늦게 숨김 — 깜빡임 방지 */
          window.setTimeout(() => thumbEl.classList.add('opacity-0'), 320);
        }
        preloaded.add(it.src);
      };

      if (imgEl.complete && imgEl.src === it.src) {
        onLoad();
      } else {
        imgEl.onload = onLoad;
        imgEl.src = it.src;
      }
    }

    triggers.forEach((btn, i) => {
      btn.addEventListener('click', () => open(i));
    });

    root.querySelector('[data-lightbox-close]')
      ?.addEventListener('click', close);
    root.querySelector('[data-lightbox-prev]')
      ?.addEventListener('click', () => move(-1));
    root.querySelector('[data-lightbox-next]')
      ?.addEventListener('click', () => move(1));

    root.addEventListener('click', (e) => {
      if (e.target === root) close();
    });

    document.addEventListener('keydown', (e) => {
      if (root.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') move(-1);
      else if (e.key === 'ArrowRight') move(1);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLightbox);
  } else {
    initLightbox();
  }
</script>
