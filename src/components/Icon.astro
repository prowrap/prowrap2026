---
interface Props {
  name: 'kakao' | 'phone' | 'arrow-right' | 'arrow-down' | 'menu' | 'close' | 'instagram' | 'youtube' | 'naver' | 'check';
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 20 } = Astro.props;
---

{name === 'kakao' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
    <path d="M12 3C6.48 3 2 6.58 2 11c0 2.86 1.92 5.36 4.78 6.78l-1.2 4.4c-.1.36.3.66.62.46l5.27-3.46c.17.02.35.02.53.02 5.52 0 10-3.58 10-8s-4.48-8-10-8z"/>
  </svg>
)}

{name === 'phone' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
  </svg>
)}

{name === 'arrow-right' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <line x1="5" y1="12" x2="19" y2="12"/>
    <polyline points="12 5 19 12 12 19"/>
  </svg>
)}

{name === 'arrow-down' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <line x1="12" y1="5" x2="12" y2="19"/>
    <polyline points="19 12 12 19 5 12"/>
  </svg>
)}

{name === 'menu' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class={className} aria-hidden="true">
    <line x1="4" y1="8" x2="20" y2="8"/>
    <line x1="4" y1="16" x2="20" y2="16"/>
  </svg>
)}

{name === 'close' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class={className} aria-hidden="true">
    <line x1="6" y1="6" x2="18" y2="18"/>
    <line x1="18" y1="6" x2="6" y2="18"/>
  </svg>
)}

{name === 'check' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <polyline points="20 6 9 17 4 12"/>
  </svg>
)}

{name === 'instagram' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class={className} aria-hidden="true">
    <rect x="2" y="2" width="20" height="20" rx="5"/>
    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-linecap="round" stroke-width="2"/>
  </svg>
)}

{name === 'youtube' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
    <path d="M23 7.5s-.2-1.55-.85-2.23c-.8-.86-1.7-.87-2.13-.92C17.05 4.13 12 4.13 12 4.13s-5.05 0-8.02.22c-.43.05-1.32.06-2.13.92C1.2 5.95 1 7.5 1 7.5S.8 9.32.8 11.13v1.7c0 1.81.2 3.63.2 3.63s.2 1.55.85 2.23c.8.86 1.86.83 2.34.93 1.7.16 7.2.22 7.2.22s5.05-.01 8.03-.22c.42-.05 1.31-.06 2.12-.92.65-.68.85-2.23.85-2.23s.2-1.81.2-3.63v-1.7c0-1.81-.2-3.63-.2-3.63zM9.74 14.85V8.66l6.5 3.1-6.5 3.09z"/>
  </svg>
)}

{name === 'naver' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
    <path d="M5 4h4l5.5 8V4H19v16h-4l-5.5-8v8H5V4z"/>
  </svg>
)}
